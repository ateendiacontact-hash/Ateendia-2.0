{
  "name": "ateendia-crm",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite --port=3100 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist server/dist",
    "db:generate": "cd server && prisma generate --schema=./prisma/schema.prisma && cd ..",
    "db:pull": "cd server && prisma db pull --schema=./prisma/schema.prisma && cd ..",
    "db:push": "cd server && prisma db push --schema=./prisma/schema.prisma && cd ..",
    "db:migrate": "cd server && prisma migrate dev --schema=./prisma/schema.prisma && cd ..",
    "db:studio": "cd server && prisma studio --schema=./prisma/schema.prisma && cd ..",
    "db:seed": "tsx server/prisma/seed.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "morgan": "^1.10.0",
    "motion": "^12.23.24",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "pocketbase": "^0.28.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "esbuild": "^0.25.0",
    "prisma": "^5.22.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^2.1.8"
  }
}