# ===========================================
# Ateendia CRM - Variables del FRONTEND
# Copia este archivo a `.env.local` y ajusta valores reales.
# ⚠️ TODO lo que empiece con VITE_ es PÚBLICO (visible en el navegador).
#    NUNCA pongas aquí: JWT_SECRET, DB_PASSWORD, SMTP_PASS, STRIPE_SECRET_KEY...
# ===========================================

# ─── Backend API ───
# En desarrollo, Vite hace proxy de /api → http://localhost:4000
VITE_BACKEND_MODE=express
VITE_API_BASE_URL=/api

# ─── Evolution API (WhatsApp) ───
# Ya tienes evolution-api corriendo en tu Docker (puerto 8080)
VITE_EVOLUTION_API_URL=http://localhost:8080
VITE_EVOLUTION_API_KEY=evolution2026
VITE_CENTRAL_SAAS_INSTANCE=central-saas

# ─── N8N (Automatizaciones) ───
VITE_N8N_WEBHOOK_URL=https://n8n.ateendia.cloud/webhook/ateendia-events

# ─── App ───
VITE_APP_URL=https://ateendia.cloud
VITE_SAAS_NAME=Ateendia CRM
VITE_SAAS_DOMAIN=ateendia.cloud

# ─── Feature Flags ───
VITE_DEBUG=false
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ─── Stripe / PayPal (SOLO claves públicas, las secretas van en server/.env) ───
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=