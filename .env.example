# ===========================================
# Ateendia CRM - Variables de Entorno
# Copia este archivo a .env.local y configura tus valores
# ===========================================

# ===========================================
# POCKETBASE (Base de Datos y Auth Principal)
# ===========================================
# URL de tu instancia PocketBase en VPS Contabo
VITE_POCKETBASE_URL=https://pb.ateendia.cloud

# ===========================================
# EVOLUTION API (WhatsApp Cloud)
# ===========================================
# URL de tu Evolution API
VITE_EVOLUTION_API_URL=http://13.140.37.155:8080
# API Key de Evolution API
VITE_EVOLUTION_API_KEY=evolution2026
# Nombre de la instancia central para notificaciones SaaS
VITE_CENTRAL_SAAS_INSTANCE=central-saas

# ===========================================
# N8N (Automatizaciones)
# ===========================================
# URL del webhook de n8n para recibir eventos del CRM
VITE_N8N_WEBHOOK_URL=https://n8n.ateendia.cloud/webhook/ateendia-events

# ===========================================
# API BACKEND (Opcional - para pagos, emails, etc.)
# ===========================================
# URL base de tu API backend (Node/Express/Python)
VITE_API_URL=https://api.ateendia.cloud

# ===========================================
# STRIPE (Pagos con Tarjeta)
# ===========================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY (solo en backend/serverless functions)
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# PAYPAL (Pagos PayPal)
# ===========================================
VITE_PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYPAL_SECRET (solo en backend)

# ===========================================
# SMTP CENTRAL SAAS (Emails transaccionales)
# ===========================================
VITE_SAAS_SMTP_HOST=ssl://smtp.gmail.com
VITE_SAAS_SMTP_PORT=465
VITE_SAAS_SMTP_USER=notifications@ateendia.cloud
VITE_SAAS_SMTP_PASS=your-app-password

# ===========================================
# CONFIGURACIÓN DE LA APP
# ===========================================
# URL pública de la aplicación
VITE_APP_URL=https://ateendia.cloud
# Nombre de la plataforma SaaS
VITE_SAAS_NAME=Ateendia CRM
# Dominio personalizado
VITE_SAAS_DOMAIN=ateendia.cloud

# ===========================================
# FEATURE FLAGS
# ===========================================
# Habilitar modo debug
VITE_DEBUG=false
# Habilitar analytics
VITE_ANALYTICS_ID=G-XXXXXXXXXX
# Habilitar Sentry
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ===========================================
# VARIABLES SOLO PARA BACKEND/FUNCTIONS (No exponer en frontend)
# Estas deben configurarse en Netlify Environment Variables
# ===========================================
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# PAYPAL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# JWY_SECRET=your-super-secret-jwt-key-min-32-chars
# ENCRYPTION_KEY=your-32-char-encryption-key
# POCKETBASE_ADMIN_EMAIL=admin@ateendia.cloud
# POCKETBASE_ADMIN_PASSWORD=your-secure-password
# N8N_API_TOKEN=your-n8n-api-token
# EVOLUTION_API_KEY=evolution2026