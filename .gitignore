# ============================================================
# .gitignore — Ateendia CRM 2.0
# Ultima actualizacion: 2026-11-12 (Sesion #35 - Fase 3.5.F.5)
# ============================================================

# ----- Variables de entorno con secretos -----
.env
.env.local
.env.*.local
.env.old
.env.old.disabled
server/.env
server/.env.local

# ----- Build & Dependencias -----
node_modules
dist
server/dist

# ----- Docker -----
mariadb_data/

# ----- Herramientas de IA -----
.roo/
.kilo/
.wrangler/

# ----- Cache de herramientas -----
.vite/
*.tsbuildinfo

# ----- Archivos temporales del sistema -----
.DS_Store
Thumbs.db

# ----- Backups de base de datos -----
backups/
backup_legacy_F5_*.zip

# ----- Configuraciones de IDE (VS Code / Kilo) -----
.vscode
.vscode/*
!.vscode/extensions.json

# ----- Archivos Legacy / Archivados (Fase 3.5.F.5) -----
# Los archivos historicos se movieron a _archive/ en la F.5.
# El contenido NO se versiona, solo el README que documenta.
_archive/*
!_archive/README.md

# ----- Logs temporales de TypeScript -----
errores_ts.txt
tsconfig.json.bak
.gitignore.bak