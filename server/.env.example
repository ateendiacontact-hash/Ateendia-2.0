# ===========================================
# Ateendia CRM - Variables del BACKEND (Express)
# Copia este archivo a `server/.env.local` y ajusta valores.
# ⚠️ NUNCA pongas prefijo VITE_ aquí. Estos son SECRETOS.
# ===========================================

NODE_ENV=development
PORT=4000

# ─── Base de datos MariaDB ───
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ⚠️ Puerto 3307 porque en 3306 está edentals-db (otro proyecto tuyo)
DATABASE_URL=mysql://ateendia:ateendia_password@localhost:3307/ateendia_crm

# ─── Seguridad JWT ───
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ─── SMTP (para envío de correos) ───
SMTP_HOST=ssl://smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=notifications@ateendia.cloud
SMTP_FROM_NAME=Ateendia CRM

# ─── CORS (dominios del frontend autorizados) ───
# En dev: http://localhost:3100 (Vite)
# En prod: tu dominio real
CORS_ORIGINS=http://localhost:3100,https://ateendia.cloud

# ─── Evolution API (WhatsApp) ───
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=evolution2026

# ─── N8N ───
N8N_WEBHOOK_URL=https://n8n.ateendia.cloud/webhook/ateendia-events
N8N_API_TOKEN=